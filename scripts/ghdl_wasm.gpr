with "../../vendor/adawebpack/gnat/adawebpack_config.gpr";

project Ghdl_Wasm is
   for Target use "llvm";
   for Source_Dirs use (".");
   for Object_Dir use ".objs";
   for Library_Name use "ghdl_wasm";
   for Library_Dir use "lib";
   for Library_Kind use "static";

   package Compiler renames AdaWebPack_Config.Compiler;
end Ghdl_Wasm;
